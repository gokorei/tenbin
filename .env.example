# Tenbin reads a knowledge store and never writes to one. It holds exactly one
# capability, and this is where it is named.
#
# The value is required: a Tenbin with no store URL raises rather than
# reporting zero, because an empty corpus and an unreachable corpus look
# identical from the outside and only one of them is a finding.
TENBIN_TANSEKI_URL=http://localhost:8088/v1

# Optional. Empty is valid; the store may not require one.
TENBIN_TANSEKI_API_KEY=

# Optional. The collection Kojutsu writes to. There is no default worth shipping:
# the store answers a search against an unknown collection with 200 and an empty
# hit list, not an error, so a wrong name reports an empty corpus as if the corpus
# were empty. Set this to the collection your Kojutsu instance writes to.
TENBIN_TANSEKI_COLLECTION=CHANGE-ME

# Optional. Request timeout in seconds.
TENBIN_TANSEKI_TIMEOUT_SECONDS=10

# Optional. Where the derived read model is written. Empty means in-memory only,
# and the program re-reads the store on every run.
TENBIN_READ_MODEL_PATH=

# The ticket source, as a second source. Empty means not configured, and the
# measures over transitions refuse by name rather than reporting over nothing.
# A retrospective needs this and does NOT need a knowledge store.
#
# The source names the adapter and the URL says where it lives; one without the
# other is unconfigured. Adapters: go-experiment, jira, linear, youtrack.
TENBIN_TICKET_SOURCE=
TENBIN_TICKET_API_URL=http://localhost:8082
TENBIN_TICKET_API_TOKEN=
# Jira only: the account email its Basic auth pairs with the API token above.
TENBIN_TICKET_API_USER=
TENBIN_TICKET_TIMEOUT_SECONDS=10

# The declared period, for `tenbin retrospective`. Both are required for that
# command and NEITHER has a default: nothing this program reads declares a
# sprint length, and a defaulted cadence would scope every figure to a
# boundary nobody chose while the rendered report said nothing about it.
#
# A cadence is a whole number of days or hours. An anchor is an ISO-8601 moment
# with a zone that starts one period. Periods are half-open: [start, end).
TENBIN_PERIOD_CADENCE=
TENBIN_PERIOD_ANCHOR=
